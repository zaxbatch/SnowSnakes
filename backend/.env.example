# ─── Server ────────────────────────────────────────────────
PORT=5000
# Set to false to silence the per-request log line.
HTTP_LOG=true

# ─── Database (Aiven Postgres) ─────────────────────────────
# Aiven requires TLS. Keep sslmode=require in the URL. If the password
# contains @ : / ? or #, URL-encode it.
DATABASE_URL=postgresql://avnadmin:password@host:port/defaultdb?sslmode=require
JWT_SECRET=replace_with_a_long_random_string

# Connection pool. Each Netlify Function container has its own small pool, so
# keep this low to stay inside Aiven's connection limit.
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=15000
# Leave TLS on for Aiven. For a local Postgres without TLS, set DB_SSL=false.
# DB_SSL=false
# Optional: path to the provider's CA bundle for certificate verification.
# DB_CA_CERT=./backend/config/aiven-ca.pem

# ─── Cloudinary ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Game assets are uploaded as Cloudinary "raw" resources under this folder.
CLOUDINARY_GAME_FOLDER=snowsnakes/games
# Netlify Functions buffer the whole multipart body (6 MB; base64 adds ~33%),
# so 4 MB per file and 4 MB per game is the safe free-plan limit. Raise these
# when running on a host without that cap (Cloudinary's raw limit is 10 MB).
GAME_MAX_FILE_BYTES=4000000
GAME_MAX_TOTAL_BYTES=4000000
CLOUDINARY_UPLOAD_TIMEOUT_MS=120000

# ─── Songs ─────────────────────────────────────────────────
# Comma-separated list of accepted audio extensions.
ALLOWED_AUDIO_FORMATS=mp3

# ─── HubSpot (optional) ────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=

# ─── Frontend URL (CORS) ───────────────────────────────────
# Comma-separated list is allowed. Netlify preview URLs are accepted too.
FRONTEND_URL=http://localhost:3000

# Secrets and local state
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build output (Netlify rebuilds this from frontend/)
frontend/build/

# Local game uploads (now stored in Cloudinary)
backend/uploads/

# Netlify CLI
.netlify/

# npm cache used inside the workspace
.npm-cache/
.npm-logs/

# Local test artifacts
.tmp-*

# Netlify CLI config (created by local test runs)
.netlify-config/

# Editor swap files (may contain secrets)
*.swp
*.kate-swp
*~

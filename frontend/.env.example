# Browser-side Cloudinary settings. These are embedded in the React bundle at
# build time, so they must be set in Netlify's build environment (not only in
# the Functions/Server scope).
REACT_APP_CLOUDINARY_CLOUD_NAME=r6natkse
REACT_APP_CLOUDINARY_IMAGE_PRESET=snowsnakes_unsigned
REACT_APP_CLOUDINARY_AUDIO_PRESET=snowsnakes_audio

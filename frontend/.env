REACT_APP_API_URL=http://localhost:5000/api
# Cloudinary presets for uploads.
# Audio (mp3) needs its own UNSIGNED preset on the account that allows the
# "video" resource type — Cloudinary stores audio in the video bucket.
# Create it at: Cloudinary dashboard -> Settings -> Upload -> Add upload preset.
REACT_APP_CLOUDINARY_IMAGE_PRESET=snowsnakes_unsigned
REACT_APP_CLOUDINARY_AUDIO_PRESET=snowsnakes_audio
